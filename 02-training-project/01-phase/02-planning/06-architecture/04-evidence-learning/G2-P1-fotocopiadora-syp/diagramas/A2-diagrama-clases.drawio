=10;" vertex="1" connectable="0" parent="c157"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c159" value="1" style="edgeLabel;html=1;fontSize=10;" vertex="1" connectable="0" parent="c157"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c160" value="Azul = Estrategia (MetodoPago y sus 3 implementaciones: polimorfismo).&lt;br&gt;Verde = Fachada (ServicioPedidos oculta repositorio, notificador y pagos a la API).&lt;br&gt;Rosa = Singleton (una sola ConexionBD por proceso).&lt;br&gt;Cohesión: Pedido no guarda ni notifica; RepositorioPedidos solo persiste; Notificador solo envía.&lt;br&gt;Rombo negro = composición (la línea, el ítem y la variante no existen sin su todo)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#333333;fontSize=11;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="330" y="1040" width="700" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>