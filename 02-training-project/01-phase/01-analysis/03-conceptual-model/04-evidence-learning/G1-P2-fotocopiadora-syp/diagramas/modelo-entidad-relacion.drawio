"/><mxPoint x="795.0" y="474" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="solicita" style="html=1;endArrow=ERzeroToMany;endFill=0;startArrow=ERzeroToOne;startFill=0;dashed=0;strokeColor=#333;fontSize=11;rounded=0;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="680" as="sourcePoint"/><mxPoint x="990" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c45" value="atiende (técnico)" style="html=1;endArrow=ERzeroToMany;endFill=0;startArrow=ERzeroToOne;startFill=0;dashed=0;strokeColor=#333;fontSize=11;rounded=0;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="740" as="sourcePoint"/><mxPoint x="990" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="reporta" style="html=1;endArrow=ERzeroToMany;endFill=0;startArrow=ERmandOne;startFill=0;dashed=0;strokeColor=#333;fontSize=11;rounded=0;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="690" as="sourcePoint"/><mxPoint x="580" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c47" value="Notación: || = uno y solo uno (participación total) · o| = cero o uno · o&lt; = cero o muchos · |&lt; = uno o muchos.&lt;br&gt;Rosa = entidad asociativa que resuelve N:M y lleva atributos propios (cantidad, precio_unitario).&lt;br&gt;CARRITO solo se guarda para clientes registrados; el del invitado vive en el navegador.&lt;br&gt;Borde doble = entidad débil (VARIANTE_PRODUCTO se identifica con el producto + num_variante).&lt;br&gt;Recursiva: CATEGORIA es subcategoría de otra CATEGORIA. Sin claves foráneas: se agregan en el modelo lógico (G2)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="540" height="110" as="geometry"/></mxCell><mxCell id="c48" value="MENSAJE_CONTACTO e INFORMACION_EMPRESA no se relacionan: el mensaje se guarda aunque el remitente&lt;br&gt;no tenga cuenta; la información de la empresa es un registro único que edita el administrador." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="905" width="620" height="40" as="geometry"/></mxCell><mxCell id="c49" value="" style="html=1;endArrow=ERmandOne;endFill=0;startArrow=ERzeroToMany;startFill=0;dashed=0;strokeColor=#333;fontSize=11;rounded=0;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105.0" y="70" as="sourcePoint"/><mxPoint x="540" y="70" as="targetPoint"/><Array as="points"><mxPoint x="1105" y="50"/><mxPoint x="540" y="50"/></Array></mxGeometry></mxCell><mxCell id="c50" value="contiene" style="html=1;endArrow=ERmandOne;endFill=0;startArrow=ERoneToMany;startFill=0;dashed=0;strokeColor=#333;fontSize=11;rounded=0;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1105.0" y="129" as="sourcePoint"/><mxPoint x="1105.0" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="tiene" style="html=1;endArrow=ERmandOne;endFill=0;startArrow=ERzeroToOne;startFill=0;dashed=0;strokeColor=#333;fontSize=11;rounded=0;endSize=10;startSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="990" y="230" as="sourcePoint"/><mxPoint x="910" y="660" as="targetPoint"/><Array as="points"><mxPoint x="950" y="230"/><mxPoint x="950" y="660"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>