..1).&lt;br&gt;Rombo negro = composición&lt;br&gt;(la variante y el ítem no existen&lt;br&gt;sin su producto o carrito)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=10;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="980" y="880" width="260" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>