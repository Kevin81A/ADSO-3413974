        <dc:Bounds x="1150" y="250" width="100" height="80" />
      </di:BPMNShape>
      <di:BPMNShape id="End_Aprendiz_di" bpmnElement="End_Aprendiz">
        <dc:Bounds x="1372" y="152" width="36" height="36" />
        <di:BPMNLabel>
          <dc:Bounds x="1352" y="188" width="76" height="27" />
        </di:BPMNLabel>
      </di:BPMNShape>
      <di:BPMNShape id="Task_VerMiHorarioAprendiz_di" bpmnElement="Task_VerMiHorarioAprendiz">
        <dc:Bounds x="880" y="80" width="100" height="80" />
      </di:BPMNShape>
