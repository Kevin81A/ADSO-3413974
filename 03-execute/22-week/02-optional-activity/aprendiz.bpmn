<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di_1="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Aprendiz_SENA" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_Aprendiz_SENA" name="Proceso Integral Modulo Aprendiz SENA" isExecutable="true">
    <bpmn:startEvent id="Start_LoginAprendiz" name="Pantalla Login">
      <bpmn:outgoing>Flow_AL1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_LoginCredencialesAprendiz" name="Ingresar Correo y Contraseña Institucional">
      <bpmn:incoming>Flow_AL1</bpmn:incoming>
      <bpmn:outgoing>Flow_AL2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ValidaLoginAprendiz" name="¿Credenciales Válidas?">
      <bpmn:incoming>Flow_AL2</bpmn:incoming>
      <bpmn:outgoing>Flow_ApOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApRecuperar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RecuperarPassAprendiz" name="Recuperar Contraseña por Correo">
      <bpmn:incoming>Flow_ApRecuperar</bpmn:incoming>
      <bpmn:outgoing>Flow_RecupBackAp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PanelAprendiz" name="Visualizar Panel Principal Aprendiz (Mi Horario)">
      <bpmn:incoming>Flow_ApOK</bpmn:incoming>
      <bpmn:incoming>Flow_RecupBackAp</bpmn:incoming>
      <bpmn:outgoing>Flow_MenuAprendiz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MenuAprendiz" name="¿Qué opción del menú selecciona?">
      <bpmn:incoming>Flow_MenuAprendiz</bpmn:incoming>
      <bpmn:outgoing>Flow_OptHorarioAprendiz</bpmn:outgoing>
      <bpmn:outgoing>Flow_OptNotificaciones</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_VerMiHorarioAprendiz" name="Consultar Horario de la Ficha (2874412)">
      <bpmn:incoming>Flow_OptHorarioAprendiz</bpmn:incoming>
      <bpmn:outgoing>Flow_BackHorarioAp</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerNotificaciones" name="Consultar Bandeja de Notificaciones y Avisos">
      <bpmn:incoming>Flow_OptNotificaciones</bpmn:incoming>
      <bpmn:outgoing>Flow_N1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DetalleNotificacion" name="¿Abrir Detalle de Notificación?">
      <bpmn:incoming>Flow_N1</bpmn:incoming>
      <bpmn:outgoing>Flow_VerDetalle</bpmn:outgoing>
      <bpmn:outgoing>Flow_CerrarNotif</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_LeerDetalleAviso" name="Ver Detalle de Cambio de Ambiente / Horario">
      <bpmn:incoming>Flow_VerDetalle</bpmn:incoming>
      <bpmn:outgoing>Flow_BackDetalle</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Aprendiz" name="Sesión / Tareas Finalizadas">
      <bpmn:incoming>Flow_BackHorarioAp</bpmn:incoming>
      <bpmn:incoming>Flow_CerrarNotif</bpmn:incoming>
      <bpmn:incoming>Flow_BackDetalle</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_AL1" sourceRef="Start_LoginAprendiz" targetRef="Task_LoginCredencialesAprendiz" />
    <bpmn:sequenceFlow id="Flow_AL2" sourceRef="Task_LoginCredencialesAprendiz" targetRef="Gateway_ValidaLoginAprendiz" />
    <bpmn:sequenceFlow id="Flow_ApOK" name="Sí" sourceRef="Gateway_ValidaLoginAprendiz" targetRef="Task_PanelAprendiz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loginValido = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApRecuperar" name="No" sourceRef="Gateway_ValidaLoginAprendiz" targetRef="Task_RecuperarPassAprendiz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=loginValido = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RecupBackAp" sourceRef="Task_RecuperarPassAprendiz" targetRef="Task_PanelAprendiz" />
    <bpmn:sequenceFlow id="Flow_MenuAprendiz" sourceRef="Task_PanelAprendiz" targetRef="Gateway_MenuAprendiz" />
    <bpmn:sequenceFlow id="Flow_OptHorarioAprendiz" name="Mi horario" sourceRef="Gateway_MenuAprendiz" targetRef="Task_VerMiHorarioAprendiz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionAprendiz = "horario"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OptNotificaciones" name="Notificaciones" sourceRef="Gateway_MenuAprendiz" targetRef="Task_VerNotificaciones">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=opcionAprendiz = "notificaciones"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BackHorarioAp" sourceRef="Task_VerMiHorarioAprendiz" targetRef="End_Aprendiz" />
    <bpmn:sequenceFlow id="Flow_N1" sourceRef="Task_VerNotificaciones" targetRef="Gateway_DetalleNotificacion" />
    <bpmn:sequenceFlow id="Flow_VerDetalle" name="Sí" sourceRef="Gateway_DetalleNotificacion" targetRef="Task_LeerDetalleAviso">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verDetalle = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CerrarNotif" name="No" sourceRef="Gateway_DetalleNotificacion" targetRef="End_Aprendiz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verDetalle = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_BackDetalle" sourceRef="Task_LeerDetalleAviso" targetRef="End_Aprendiz" />
  </bpmn:process>
  <di:BPMNDiagram id="BPMNDiagram_1">
    <di:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Aprendiz_SENA">
      <di:BPMNShape id="Gateway_ValidaLoginAprendiz_di" bpmnElement="Gateway_ValidaLoginAprendiz" isMarkerVisible="true">
