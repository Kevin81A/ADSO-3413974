      </di:BPMNEdge>
      <di:BPMNEdge id="Flow_AL2_di" bpmnElement="Flow_AL2">
        <di_1:waypoint x="420" y="200" />
        <di_1:waypoint x="485" y="200" />
      </di:BPMNEdge>
